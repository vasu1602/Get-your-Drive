# =============================================================================
# GET YOUR DRIVE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Port
PORT=3000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud)
MONGODB_URI=mongodb://127.0.0.1:27017/getyourdrive

# JWT Secret Keys
JWT_SECRET=your_super_secret_jwt_key_here
JWT_VERIFY_SECRET=your_otp_verification_secret_key_here

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL SERVICE CONFIGURATION (Choose One Option)
# =============================================================================

# Option 1: Gmail App Password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Option 2: Resend API
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Get Your Drive <onboarding@resend.dev>"

# Option 3: Standard SMTP (SendGrid, Brevo, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Get Your Drive <no-reply@getyourdrive.com>"
