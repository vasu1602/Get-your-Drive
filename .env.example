# =============================================================================
# GET YOUR DRIVE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Port
PORT=3000

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://getyourdrive-148f5-default-rtdb.firebaseio.com

# JWT Secret Keys
JWT_SECRET=your_super_secret_jwt_key_here
JWT_VERIFY_SECRET=your_otp_verification_secret_key_here

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL SERVICE CONFIGURATION (Resend & Gmail SMTP)
# =============================================================================

# Primary: Resend API
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Get Your Drive <onboarding@resend.dev>"

# Secondary: Gmail App Password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
